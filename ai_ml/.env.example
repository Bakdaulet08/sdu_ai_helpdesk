# Only used by the knowledge-base commands, not by the Go backend.
# Local test DB from compose.kb.yml. Do not commit real credentials.
KB_DATABASE_URL=postgresql://sdu_kb:sdu_kb_local@127.0.0.1:55432/sdu_kb
KB_DEVICE=cpu
KB_BATCH_SIZE=16
# Initial value only. Calibrate on real questions and out-of-domain examples.
KB_MIN_SIMILARITY=0.80

# Generation: openai or gemini. Choose a model available in your provider account
# that supports Chat Completions with JSON object output.
LLM_PROVIDER=openai
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
KB_CONTEXT_FILE=config/university_context.txt

# API request journal; relative paths resolve from ai_ml.
KB_REQUEST_LOG=data/logs/requests.sqlite3
KB_DATASET=faq
